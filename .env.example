# Copia este archivo a .env y rellena lo que necesites.
#
#   cp .env.example .env
#
# .env esta en .gitignore: nunca se commitea. Este ejemplo si, para que se vea
# que variables existen sin tener que buscarlas en el codigo.
#
# Regla: lo que pongas en el entorno real gana sobre este archivo. El .env solo
# rellena lo que falte.

# Inicio de sesion con GitHub (device flow).
#
# Registra una OAuth App en https://github.com/settings/applications/new
#   Application name:  MovilClaw
#   Homepage URL:      http://127.0.0.1:8788
#   Enable Device Flow: MARCADO   <- sin esto el flujo no funciona
# Copia el Client ID (el secret NO hace falta: el device flow no lo usa).
MOVILCLAW_GITHUB_CLIENT_ID=

# Donde guarda el servidor su estado (sellos y manifiestos).
# Por defecto: ~/.movilclaw
#MOVILCLAW_STATE=

# Puerto y direccion de escucha. Por defecto 8788 en 127.0.0.1.
#PORT=8788
#HOST=127.0.0.1

# Solo para desarrollo: habilita el endpoint que ejecuta comandos dentro del
# sandbox desde la API. En uso normal, dejalo sin definir.
#MOVILCLAW_ALLOW_EXEC=1

# Secreto con el que se firman los permisos de sellado. Si no lo pones, se genera
# uno por proceso y los permisos no sobreviven a un reinicio (que es lo seguro).
#MOVILCLAW_GRANT_SECRET=
