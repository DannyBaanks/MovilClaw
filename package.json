{
  "name": "movilclaw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pocket client and sandbox orchestrator for AutoClaw: isolated sandboxes that clone, work and open pull requests without holding your credentials.",
  "scripts": {
    "start": "node server/api.mjs",
    "server": "node server/api.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:isolation": "node --test tests/isolation.test.mjs",
    "sandbox:build": "docker build -t movilclaw/sandbox:latest server/",
    "probar": "bash scripts/probar.sh",
    "ios:instalar": "bash scripts/instalar-ios.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DannyBaanks/MovilClaw.git"
  },
  "homepage": "https://github.com/DannyBaanks/MovilClaw#readme",
  "bugs": {
    "url": "https://github.com/DannyBaanks/MovilClaw/issues"
  },
  "keywords": [
    "autoclaw",
    "sandbox",
    "agent",
    "docker",
    "isolation",
    "github",
    "pwa"
  ]
}
